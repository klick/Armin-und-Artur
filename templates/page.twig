{% extends "_layout" %}

{% block content %}

<div class="container">
	<article class="generic">
		<header class="text-center">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-5 fs-4">
					<h1 class="display-5">{{ entry.title | widont }}</h1>
				</div>
			</div>
		</header>
		<section class="article-body">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-7 fs-4">
					{{ entry.body | typogrify }}
				</div>
			</div>
		</section>
	</article>
</div>
{% endblock %}