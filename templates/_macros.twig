{#
 # IMG SRCSET
 #}

{% macro imgFullWidth(img, imgLink, deferImages, params, imageAltText, caption) %}
	{% if img.hasFocalPoint is defined %}
		{% set focalPoint = img.getFocalPoint() %}
		{% set position = img.getFocalPoint() %}
	{% else %}
		{% set position = 'center-center' %}
	{% endif %}

	{% set transformedImages = craft.imager.transformImage(img, 
		params
		, { ratio: 16/9, position:position, jpegQuality: 80 }) 
	%}

	{% if imgLink|length %}
	<a href="{{ imgLink }}">
		<img data-sizes="auto" {{ deferImages ? 'data-' }}src="{{ craft.imager.transformImage(img, { width: 800, height: 500, mode: 'crop', position:position }) }}" {{( img.imageAltText is defined ? 'alt="' ~ img.imageAltText ~ '"')|raw }} {{ deferImages ? 'data-' }}srcset="{{ craft.imager.srcset(transformedImages) }}" class="{{ deferImages ? 'lazyload' }}">
	</a>
	{% else %}
	<img data-sizes="auto" {{ deferImages ? 'data-' }}src="{{ craft.imager.transformImage(img, { width: 800, height: 500, mode: 'crop', position:position }) }}" {{( img.imageAltText is defined ? 'alt="' ~ img.imageAltText ~ '"')|raw }} {{ deferImages ? 'data-' }}srcset="{{ craft.imager.srcset(transformedImages) }}" class="{{ deferImages ? 'lazyload' }}">
	{% endif %}
	{% if caption %}
	<figcaption>
		{{ img.caption|length ? img.caption }}
	</figcaption>
	{% endif %}
{% endmacro %}

{% macro byLine(entry, authorLink = true) %}
	<p class="author mb-1 lh-1">
		<i>von</i>&thinsp;<span class="font-small-caps">
		{% if authorLink == true %}
			<a href="{{ entry.verfasser.one().url }}" class="lh-1 d-inline-block">{{ entry.verfasser.one().title ? entry.verfasser.one().title : 'Unbekannt' }}</a>
		{% else %}
			<span class="lh-1 d-inline-block">{{ entry.verfasser.one().title ? entry.verfasser.one().title : 'Unbekannt' }}</span>
		{% endif %}
		</span>
	</p>
	<p class="m-0 lh-1"><span class="font-small-caps text-secondary d-block d-md-inline"><span class="d-none d-md-inline"></span>~{{ entry.readtime }} Min</span></p>
{% endmacro %}