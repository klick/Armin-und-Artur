										<input class="form-control p-1 ps-2 flex-grow-1 me-2" type="search" name="suchbegriff" aria-label="Search" placeholder="Suchbegriff + Enter">
										<div class="close d-md-none">
											/
										</div>
										<div class="close d-md-none">
											x
										</div>
									</div>
								</form>
							</div>
							<div class="site-tools d-md-flex">
