								</svg>
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>
		

		<div class="main-content">
			{% block content %}
				<p>If you see me, you haven’t set your <code>{% verbatim %}{% block content %}…{% endblock %}{% endverbatim %}</code> yet.</p>
				<p>See Twig’s <a href="http://twig.sensiolabs.org/doc/templates.html#template-inheritance">Template Inheritance</a> documentation for an explanation.</p>
			{% endblock %}
		</div>

		<footer class="footer-global color-negative mt-5">
			<div class="container text-center font-small-caps">
				<ul class="list-unstyled">
					<li class="d-inline"><small><a class="text-body-tertiary me-3" href="kontakt">Kontakt</a></small></li>
					<li class="d-inline"><small><a class="text-body-tertiary me-3" href="impressum">Impressum</a></small></li>
					<li class="d-inline"><small><a class="text-body-tertiary" href="datenschutz">Datenschutz</a></small></li>
				</ul>
			</div>
		</footer>

	</div>

		

		

		


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
{# {% do view.registerJsFile(rev('js/bundle.js')) %} #}

{% if currentUser == null %}
<script>(function() {
var tag = document.createElement('script');
tag.src = "https://plausible.io/js/plausible.js";
tag.defer = true;
tag.setAttribute("data-domain", "arminundartur.de");
var firstScriptTag = document.getElementsByTagName('script')[0];
firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
})();
</script>
{% endif %}

{%- js -%}
	$(document).ready(function(){

  $(document).on('click', '.color-mode-icon.light', function(e) {
    $('body').attr('data-bs-theme', 'dark');
    $(this).addClass('dark').removeClass('light');
    document.cookie = "aatheme=dark; max-age=" + 30*24*60*60;
    $("meta[name='theme-color']").attr("content", "#212529");
  });
  $(document).on('click', '.color-mode-icon.dark', function(e) {
    $('body').attr('data-bs-theme', 'light');
    $(this).addClass('light').removeClass('dark');
    document.cookie = "aatheme=light; max-age=" + 30*24*60*60;
    $("meta[name='theme-color']").attr("content", "#F9F4E6");
  });
  $(document).on('click', '.search-icon', function(e) {
    $('div.site-name').addClass('d-none d-md-block');
    $('div.site-tools').addClass('d-none d-md-flex');
    $('div.search-form').removeClass('d-none').addClass('d-md-block');
  });
  $(document).on('click', 'div.close', function(e) {
  	$('div.search-form').removeClass('d-md-block').addClass('d-none');
  	$('div.site-name').removeClass('d-none d-md-block');
    $('div.site-tools').removeClass('d-none d-md-flex');
  });
	
});
{%- endjs -%}


</body>
</html>
