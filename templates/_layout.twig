						<div class="headerbar d-flex justify-content-between align-items-center">
							<div class="site-name">
								<p class="m-0"><a href="/"><span class="color-base font-small-caps">Armin & Artur</span></a></p>
							</div>
							<div class="search-form d-none d-md-block flex-grow-1 flex-md-grow-0 ms-auto me-md-3">
								<form action="{{ url('suche') }}" class="">
