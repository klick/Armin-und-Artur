{% extends "_layout" %}
{% set allEntries = craft.entries.section('geschichten').relatedTo(entry).with(['kategorie']).orderBy('title').all() %}
{% set allEntriesByGroup = allEntries | group('title[:1]') %}



{% block content %}

<div class="container">
	<article class="story">
		<header class="text-center mb-4">
		{% if entry.bild|length %}
			<div class="row justify-content-center m-3">
				<div class="col-6 col-md-6 col-lg-2">
					{% set profileImg = entry.bild.one() %}
					{% set profileImgTransforms = {
					  '(min-width: 1px)': {
					      width: 200,
					      height: 200,
					      format: 'webp',
					  }
					} %}
					{%- set profileImgAttributes = {alt: profileImg.imgAlttext, title: profileImg.title, class: 'rounded-circle', loading:'lazy' } -%}
					<figure class="m-0">
						{{ craft.images.pictureMedia(profileImg, profileImgTransforms, null, profileImgAttributes) }}
					</figure>
				</div>
			</div>
			{% endif %}
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-5 fs-4">
					<h1 class="display-5">{{ entry.title | widont }}</h1>
				</div>
			</div>
		</header>
		<section class="article-body text-center">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-7">
					{% cache %}
            {% for firstletter, entriesInGroup in allEntriesByGroup %}
            <h3 class="h5 fw-bold">{{firstletter}}</h3>
            <ul class="list-unstyled">
            {% for entry in entriesInGroup %}
                <li>
                    <a href="{{ entry.url }}" style="display:block;padding: 6px 0">
                        {{ entry.title|raw }} 
                        {# <small style="font-size: 14px">{{ entry.body }} </small><br><a href="{{ entry.cpEditUrl }}">Edit</a>
                        ({{ entry.readtime }} {{ entry.readtime > 1 ? 'Minuten' : 'Minute' }}) #}
                    </a>
                </li>
            {% endfor %}
            </ul><br><br>
            {% endfor %}
            {% endcache %}
				</div>
			</div>
		</section>
	</article>
</div>
{% endblock %}


