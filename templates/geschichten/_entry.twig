{% import '_macros.twig' as macros %}
{% extends "_layout" %}
{% set inCollection = craft.entries.sectionId(6).relatedTo(entry).one() %}

{% set minutes = entry.readtime %}

{% set hours = minutes // 60 %}
{% set remainingMinutes = minutes % 60 %}

{% set mainEntity = seomatic.jsonLd.get('mainEntityOfPage') %}
{% do mainEntity.setAttributes({
   'timeRequired': "PT" ~ hours ~ "H" ~ remainingMinutes ~ "M",
}) %}



{% block content %}

<div class="container">
	<article class="story mt-5 mt-md-0">
		<header class="text-center mb-5">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-6 fs-4">
					<h1 class="display-4 mb-3">{{ entry.title | widont }}</h1>
					{{ macros.byLine(entry, true) }}
				</div>
			</div>
		</header>
		<section class="article-body">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-7 fs-4">
					{{ entry.body | typogrify }}
				</div>
				<div class="col-11 col-md-9 col-lg-7 fs-4 text-center mt-5">
					❦
				</div>
			</div>
		</section>
		<aside>
			{% if inCollection %}
				<div class="row justify-content-center mt-5">
					<div class="col-11 col-md-9 col-lg-5 fs-4">
						<p>Aus: <b>{{ inCollection.title }}</b><br><a href="{{ inCollection.url }}">Zur kompletten Sammlung &rarr;</a></p>
					</div>
				</div>
			{% endif %}
		</aside>
	</article>
</div>

{% endblock %}