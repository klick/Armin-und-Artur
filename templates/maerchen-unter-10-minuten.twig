{% extends "_layout" %}


{% block content %}

<div class="container">
	<article class="story">
		<header class="text-center mb-4">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-5 fs-4">
					<h1 class="display-3">{{ entry.title }}</h1>
				</div>
			</div>
		</header>
		<section class="article-body text-center">
			<div class="row justify-content-center">
				<div class="col-11 col-md-9 col-lg-7 fs-4">
					{% cache %}
					{% set shorts = craft.entries.sectionId(1).readtime(["<= 10"]).orderBy('readtime').all() %}
					{% set allShortsByGroup = shorts | group('readtime') %}
          {% for minutes, entriesInGroup in allShortsByGroup %}
          <h3 class="h2 fw-bold mt-6 font-small-caps">~{{minutes}}MIN</h3>
          <ul class="list-unstyled">
          {% for entry in entriesInGroup %}
            <li>
              <a href="{{ entry.url }}" style="display:block;padding: 6px 0" class="">
                <div>{{ entry.title|raw }}</div>
              </a>
            </li>
          {% endfor %}
          </ul>
          {% endfor %}
          {% endcache %}
				</div>
			</div>
		</section>
	</article>
</div>
{% endblock %}