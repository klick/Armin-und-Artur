{% extends '_layout' %}

{% block content %}
  {% set isMainnet = expectedPayment.network == 'eip155:8453' %}
  <main class="container my-5" id="x402-browser-test"
    data-endpoint="{{ endpoint }}"
    data-expected-payment="{{ expectedPayment|json_encode|e('html_attr') }}">
    <article class="col-12 col-lg-8 mx-auto">
      <p class="text-uppercase small text-muted mb-2">Nur lokale Entwicklungsumgebung</p>
      <h1 class="display-5 mb-3">x402 {{ isMainnet ? 'Mainnet' : 'Testnet' }}-Test: Rotkäppchen</h1>
      <p>Dieser Test verbindet ausschließlich eine vorhandene Browser-Wallet. Er fragt nie nach Seed Phrase oder Private Key und erzeugt keine Zahlung vor dem letzten, ausdrücklich beschrifteten Klick.</p>

      <div class="alert {{ isMainnet ? 'alert-danger' : 'alert-warning' }}" role="alert">
        {% if isMainnet %}
          Base Mainnet: Der letzte Klick autorisiert eine echte Zahlung von 0,01 USDC. Nicht klicken, bevor Empfänger und Betrag geprüft sind.
        {% else %}
          Ausschließlich für Base Sepolia und Test-USDC. Nicht in Produktion verfügbar.
        {% endif %}
      </div>

      <section class="card mb-3" aria-labelledby="challenge-heading">
        <div class="card-body">
          <h2 class="h4" id="challenge-heading">1. Zahlungsanforderung laden</h2>
          <button class="btn btn-outline-primary" type="button" data-action="load-challenge">Anforderung laden</button>
          <dl class="row mt-3 mb-0" data-payment-preview hidden>
            <dt class="col-sm-4">Netzwerk</dt><dd class="col-sm-8" data-field="network">–</dd>
            <dt class="col-sm-4">Asset</dt><dd class="col-sm-8 text-break" data-field="asset">–</dd>
            <dt class="col-sm-4">Empfänger</dt><dd class="col-sm-8 text-break" data-field="payTo">–</dd>
            <dt class="col-sm-4">Preis</dt><dd class="col-sm-8" data-field="amount">–</dd>
          </dl>
        </div>
      </section>

      <section class="card mb-3" aria-labelledby="wallet-heading">
        <div class="card-body">
          <h2 class="h4" id="wallet-heading">2. Testkäufer verbinden</h2>
          <p class="small text-muted">MetaMask zeigt die Kontenauswahl selbst. Danach wählst du hier ausdrücklich das Käuferkonto.</p>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-primary" type="button" data-action="connect-wallet">MetaMask verbinden</button>
            <button class="btn btn-outline-secondary" type="button" data-action="switch-network" disabled>Zu Base Sepolia wechseln</button>
          </div>
          <label class="form-label mt-3" for="buyer-account">Testkäuferkonto</label>
          <select class="form-select" id="buyer-account" data-account-select disabled>
            <option value="">Noch nicht verbunden</option>
          </select>
          <p class="small mb-0 mt-2" data-wallet-status>Wallet noch nicht verbunden.</p>
        </div>
      </section>

      <section class="card mb-3" aria-labelledby="sign-heading">
        <div class="card-body">
          <h2 class="h4" id="sign-heading">3. Signieren und einmalig abrufen</h2>
          <p>Der folgende Klick erstellt eine auf 60 Sekunden begrenzte EIP-3009-Zahlungsautorisierung über exakt 0,01 {{ isMainnet ? 'USDC (echtes Geld)' : 'Test-USDC' }} an den oben angezeigten Empfänger. MetaMask zeigt die Signaturanfrage an.</p>
          <button class="btn btn-danger" type="button" data-action="sign-and-fetch" disabled>0,01 {{ isMainnet ? 'USDC (ECHT)' : 'Test-USDC' }} signieren und Rotkäppchen abrufen</button>
        </div>
      </section>

      <section class="card" aria-live="polite" aria-labelledby="result-heading">
        <div class="card-body">
          <h2 class="h4" id="result-heading">Ergebnis</h2>
          <p class="mb-2" data-result-status>Bereit. Noch keine Netzwerk- oder Wallet-Aktion ausgeführt.</p>
          <details data-payment-response hidden><summary><code>PAYMENT-RESPONSE</code></summary><pre class="mt-3"><code data-payment-response-content></code></pre></details>
          <details data-unlocked-json hidden><summary>Freigeschaltetes Vorlese-JSON</summary><pre class="mt-3"><code data-unlocked-json-content></code></pre></details>
        </div>
      </section>
    </article>
  </main>
  <script type="module" src="/js/story-api-x402-browser-test.js"></script>
{% endblock %}
