{
  "require": {
    "besteadfast/craft-preparse-field": "^2.0",
    "carlcs/craft-redactorcustomstyles": "^4.0",
    "clubstudioltd/craft-asset-rev": "^7.0",
    "craftcms/cms": "4.4.16.1",
    "craftcms/feed-me": "^5.2",
    "craftcms/redactor": "^3.0",
    "nystudio107/craft-seomatic": "^4.0",
    "putyourlightson/craft-blitz-recommendations": "^2.1",
    "robuust/craft-reverserelations": "^2.0",
    "topshelfcraft/wordsmith": "^4.2",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^1.3.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.0.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  }
}
