{
  "require": {
    "carlcs/craft-redactorcustomstyles": "^4.0",
    "clubstudioltd/craft-asset-rev": "^7.0",
    "craftcms/cms": "4.15.0.2",
    "craftcms/element-api": "4.2.0",
    "craftcms/feed-me": "5.11.0",
    "craftcms/redactor": "3.1.0",
    "craftsnippets/craft-image-toolbox": "2.3.1",
    "dolphiq/redirect": "^2.0",
    "ether/tags": "^2.0",
    "jalendport/craft-preparse": "2.1.2",
    "nystudio107/craft-cookies": "^4.0",
    "nystudio107/craft-seomatic": "4.1.12",
    "putyourlightson/craft-blitz-recommendations": "2.2.1",
    "robuust/craft-reverserelations": "^2.0",
    "topshelfcraft/wordsmith": "4.5.0",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^1.3.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.0.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}