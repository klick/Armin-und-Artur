# Read about configuration, here:
# https://craftcms.com/docs/4.x/config/

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# The secure key Craft will use for hashing and encrypting data
CRAFT_SECURITY_KEY=

# Database connection settings
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# General settings (see config/general.php)
DEV_MODE=true
ALLOW_ADMIN_CHANGES=true
DISALLOW_ROBOTS=true

# Story API / x402 pilot. Use Base Sepolia and a dedicated test wallet only.
STORY_API_X402_ENABLED=true
STORY_API_X402_MAINNET_ENABLED=false
STORY_API_X402_NETWORK=eip155:84532
STORY_API_X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
STORY_API_X402_PAY_TO=
STORY_API_X402_PRICE_ATOMIC=10000
STORY_API_X402_FACILITATOR_URL=https://x402.org/facilitator
